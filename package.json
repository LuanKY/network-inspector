{
  "name": "@luanky/network-inspector",
  "version": "1.0.0",
  "description": "Inspetor e monitor de requisicoes HTTP universal para React Native, React, Angular, Vue e Desktop.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./react-native": {
      "types": "./dist/react-native/index.d.ts",
      "default": "./dist/react-native/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc"
  },
  "keywords": [
    "network",
    "inspector",
    "logger",
    "http",
    "react-native",
    "react",
    "angular",
    "vue",
    "universal"
  ],
  "author": "Luan Kyrtinem",
  "license": "MIT",
  "peerDependencies": {
    "@expo/vector-icons": "*",
    "expo-clipboard": "*",
    "react": "*",
    "react-native": "*",
    "react-native-safe-area-context": "*"
  },
  "peerDependenciesMeta": {
    "@expo/vector-icons": {
      "optional": true
    },
    "expo-clipboard": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    }
  }
}
